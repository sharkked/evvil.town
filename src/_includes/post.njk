---
layout: main.njk
---
<style>
main {
  max-width: 1000px;
  margin: auto;
  justify-content: start;
  font-size: 1rem;
}

article {
  width: 100%;
}

.post-header {
  padding: 2rem 0;
}

.post-header__date {
  opacity: 0.5;
}

.post-content {
  flex: 1;
  font-family: "Source Sans 3", sans-serif;

  &p {
    line-height: 1.5rem;
    padding: 0.5rem 0;
  }

  &img {
    display: block;
    margin: auto;
  }
}
</style>

<article>
  <div class="post-header">
    ---
    <h1>{{ title }}</h1>
    <div class="post-header__date">{{ page.date }}</div>
    ---
  </div>
  <div class="post-content">
  {{ content | safe }}
  </div>
</article>
