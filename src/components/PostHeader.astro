---
const { title, date } = Astro.props
---

<div class="post-header">
  ---
  <h1>{title}</h1>
  <h2 class="post-header__date">
    {date}
  </h2>
  ---
</div>

<style>
  .post-header {
    padding: 2rem 0;
    width: 100%;
    font-family: var(--font-lilex);

    h1 {
      font-size: 2rem;
      font-weight: 400;
    }

    h2 {
      font-size: 1rem;
      font-weight: 400;
      opacity: 0.5;
    }
  }
</style>
