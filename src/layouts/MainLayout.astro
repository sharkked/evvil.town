---
import { Font, Image } from 'astro:assets'
import BaseLayout from './BaseLayout.astro'
import Navbar from '@/components/Navbar.astro'
import logoLight from '@/images/logo_light.png'
import logoDark from '@/images/logo_dark.png'
const { title } = Astro.props
const pageTitle = title ? `${title} ~ evvil.town` : 'evvil.town'
---

<BaseLayout title={pageTitle}>
  <Font cssVariable="--font-barcode-128-text" slot="head" />
  <link
    rel="preload"
    as="img"
    href={logoLight.src}
    fetchpriority="high"
    slot="head"
  />
  <link
    rel="preload"
    as="img"
    href={logoDark.src}
    fetchpriority="high"
    slot="head"
  />

  <header class="page-header">
    <div class="page-header__primary">
      <div class="page-header__stamp">
        AN ACCESSIBILITY NIGHTMARE &#xFF5C; COULD YOU IMAGINE IF I HAD FUNNY
        BITS &#xFF5C; WE WOULD RULE THE WORLD &#xFF5C; AS BROTHERS. BUT IN A
        GIRL WAY &#xFF5C; IF ONLY THERE WERE A WORD FOR THAT &#xFF5C; COULD YOU
        IMAGINE A WORLD WE YOU COULD BE GIRLBROTHERS &#xFF5C; BUT IN A
        GENDERLESS SORT OF WAY. &#xFF5C COULD YOU IMAGINE LIFE AS GENDERLESS
        GIRLBROTHERS &#XFF5C; IT WOULD PROBABLY BE A LITTLE BRIGHTER THAN THIS
        ONE &#xFF5C; OKAY ALRIGHT WE GET IT YOU HAVE A BIG MONITOR &#xFF5C; OR I
        GUESS YOU JUST ZOOMED OUT REALLY FAR. THAT TOO &#xFF5C; I'M NOT
        OBLIGATED TO ENTERTAIN YOU FURTHER.
      </div>
      <Image
        class="page-header__logo"
        src={logoLight}
        alt="evvil.town"
        height={50}
        width={228}
        quality={100}
        format="png"
        loading="eager"
        fetchpriority="high"
      />
      <span class="spacer"></span>
      <div class="barcode">never kill yourself</div>
    </div>
    <Navbar class="global-nav" />
  </header>

  <main>
    <slot />
  </main>
</BaseLayout>

<style>
  #logo {
    padding-right: 1rem;
    cursor: default;
  }

  .avi {
    width: 256px;
    height: 256px;
    border: 2px solid var(--border-color);
    border-radius: 100%;
    overflow: hidden;

    & img {
      margin: auto;
    }
  }

  .page-header {
    display: block;
    width: 100%;
    border-top: 1px solid black;
    border-bottom: 1px solid black;
  }

  .page-header__primary {
    position: relative;
    display: flex;
    height: 9rem;
    place-items: end;
    justify-content: center;
  }

  .page-header__stamp {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .page-header__logo {
    image-rendering: pixelated;
    width: 456px;
    height: 100px;
    margin: 0.5rem;
  }

  .page-header :global(nav) {
    gap: 0.5rem;
    padding: 0.5rem 0;
    font-size: 1rem;
    border-top: 3px solid black;
    text-transform: uppercase;

    a[data-active='false'] {
      color: black;
    }
  }

  .barcode {
    font-family: var(--font-barcode-128-text);
    font-size: 2rem;
  }

  @media (max-width: 738px) {
    .page-header__primary {
      height: 6rem;
    }

    .page-header__logo {
      width: 228px;
      height: 50px;
    }
  }

  .pink {
    color: var(--st-c-blood);
  }

  .note {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: black;
    font: var(--font-im-fell-dw-pica);
    line-height: 1.12rem;
  }
</style>
