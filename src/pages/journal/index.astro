---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/MainLayout.astro'
import PostHeader from '@/components/PostHeader.astro'

const publishedBlogEntries = await getCollection('blog', ({ data }) => {
  return data.draft !== true
})
publishedBlogEntries.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)
---

<Layout title="journal">
  <PostHeader title="journal" date={publishedBlogEntries[0].data.date} />
  <article>
    <p>
      if you wanna read my ramblings, i post once in a blue moon.<a
        id="rss-feed"
        title="rss/atom feed"
        href="/feed.xml"
        ><svg
          fill="currentColor"
          width="1rem"
          height="1rem"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 32 32"
        >
          <path
            d="M 5 5 L 5 9 C 14.93 9 23 17.07 23 27 L 27 27 C 27 14.85 17.15 5 5 5 z M 5 12 L 5 16 C 11.07 16 16 20.93 16 27 L 20 27 C 20 18.72 13.28 12 5 12 z M 8 21 A 3 3 0 0 0 8 27 A 3 3 0 0 0 8 21 z"
          ></path>
        </svg>
      </a>
    </p>
    <ul>
      {
        publishedBlogEntries.map((post) => (
          <li>
            <a href={'/journal/posts/' + post.id}>{post.data.title}</a>
            <br />
            <span style="opacity: 0.5">
              @ {post.data.date}
              <br />~
            </span>
            {post.body?.slice(0, 280).replace(/\.?\s*\w*\s*$/, '...')}
          </li>
        ))
      }
    </ul>

    <div class="todo-list">
      ---<br />
      <br />
      TODO:<br />
      - [ ] make the tags do something<br />
      <br />
      ---
    </div>
  </article>
</Layout>

<style>
  ul {
    list-style-type: '# ';
  }

  #rss-feed svg {
    display: inline-block;
    vertical-align: top;
    margin: 0.25rem 0;
  }

  article {
    display: flex;
    flex-direction: column;
    width: 100%;
    font-family: var(--font-lilex);
    flex: 1;

    ul {
      flex: 1;
    }

    a:hover {
      text-decoration: underline;
    }
  }

  .todo-list {
    padding: 2rem 0;
  }
</style>
